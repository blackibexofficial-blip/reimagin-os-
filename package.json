{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "name": "reimagin-os",
    "description": "Reimagin OS — Laravel admin panel, CMS, visual page builder and storefront.",
    "scripts": {
        "setup": "python3 tools/vendor/fetch.py && python3 tools/wasm/gen-autoload.py && node --experimental-wasm-jspi tools/wasm/artisan.mjs key:generate && node --experimental-wasm-jspi tools/wasm/artisan.mjs migrate --force",
        "build": "vite build",
        "dev": "vite",
        "serve": "node --experimental-wasm-jspi tools/wasm/serve.mjs",
        "preview": "npm run build && node --experimental-wasm-jspi tools/wasm/serve.mjs 8000",
        "artisan": "node --experimental-wasm-jspi tools/wasm/artisan.mjs",
        "test": "node --experimental-wasm-jspi tools/wasm/test.mjs",
        "autoload": "python3 tools/wasm/gen-autoload.py"
    },
    "devDependencies": {
        "@php-wasm/node": "3.1.64",
        "@php-wasm/universal": "3.1.64",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.0.0",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@alpinejs/sort": "^3.17.5",
        "alpinejs": "^3.17.5"
    }
}
